generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ConversationStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RealtimeSessionStatus {
  CREATED
  CONNECTED
  COMPLETED
  FAILED
}

enum AnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MistakeCategory {
  GRAMMAR
  VOCABULARY
  EXPRESSION
}

enum MistakeStatus {
  LEARNING
  MASTERED
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  locale         String            @default("zh-CN")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  profile        UserProfile?
  conversations  Conversation[]
  favoriteScenes FavoriteScene[]
  mistakes       Mistake[]
  vocabulary     VocabularyEntry[]

  @@map("users")
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  displayName         String?
  nativeLanguage      String   @default("zh-CN")
  targetLanguage      String   @default("en")
  level               String   @default("A2")
  dailyGoalMinutes    Int      @default(10)
  voice               String   @default("marin")
  speechSpeed         Float    @default(1)
  correctionFrequency String   @default("balanced")
  learningGoal        String   @default("daily")
  showChinese         Boolean  @default(true)
  autoPlay            Boolean  @default(true)
  saveAudio           Boolean  @default(false)
  saveConversation    Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Scene {
  id               String            @id @default(cuid())
  slug             String            @unique
  titleKey         String
  descriptionKey   String
  searchText       String            @db.Text
  systemPrompt     String            @db.Text
  category         String
  coverTone        String
  coverMark        String
  difficulty       Int
  estimatedMinutes Int
  lessonCount      Int
  content          Json?
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  conversations    Conversation[]
  favoritedBy      FavoriteScene[]
  mistakes         Mistake[]
  vocabulary       VocabularyEntry[]

  @@index([category, isActive, sortOrder])
  @@map("scenes")
}

model FavoriteScene {
  id        String   @id @default(cuid())
  userId    String
  sceneId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene     Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([userId, sceneId])
  @@index([userId, createdAt])
  @@map("favorite_scenes")
}

model Conversation {
  id               String             @id @default(cuid())
  userId           String
  sceneId          String?
  status           ConversationStatus @default(ACTIVE)
  startedAt        DateTime           @default(now())
  endedAt          DateTime?
  durationSeconds  Int?
  summary          String?            @db.Text
  newExpressions   Int                @default(0)
  corrections      Int                @default(0)
  mastery          Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene            Scene?             @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  messages         Message[]
  realtimeSessions RealtimeSession[]
  analysisJobs     AnalysisJob[]
  mistake          Mistake?
  vocabulary       VocabularyEntry[]

  @@index([userId, createdAt])
  @@index([sceneId])
  @@map("conversations")
}

model Mistake {
  id             String          @id @default(cuid())
  userId         String
  conversationId String          @unique
  sceneId        String
  original       String          @db.Text
  improved       String          @db.Text
  reasonZh       String          @db.Text
  reasonEn       String          @db.Text
  category       MistakeCategory @default(EXPRESSION)
  reviewCount    Int             @default(0)
  status         MistakeStatus   @default(LEARNING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  scene          Scene           @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([sceneId])
  @@map("mistakes")
}

model VocabularyEntry {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  sceneId        String
  phrase         String
  meaningZh      String       @db.Text
  meaningEn      String       @db.Text
  example        String       @db.Text
  favorite       Boolean      @default(false)
  reviewCount    Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  scene          Scene        @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([userId, phrase])
  @@index([userId, favorite, createdAt])
  @@index([sceneId])
  @@map("vocabulary_entries")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  clientEventId  String?
  role           MessageRole
  content        String       @db.Text
  transcript     String?      @db.Text
  sequence       Int
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@unique([conversationId, clientEventId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

model RealtimeSession {
  id                String                @id @default(cuid())
  conversationId    String
  providerSessionId String?
  status            RealtimeSessionStatus @default(CREATED)
  configuration     Json?
  startedAt         DateTime              @default(now())
  endedAt           DateTime?
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("realtime_sessions")
}

model AnalysisJob {
  id             String         @id @default(cuid())
  conversationId String
  type           String
  status         AnalysisStatus @default(PENDING)
  result         Json?
  errorMessage   String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, status])
  @@map("analysis_jobs")
}
