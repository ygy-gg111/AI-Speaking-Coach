# Database
DATABASE_URL="mysql://english_app:password@localhost:3306/english_speaking"
# Use mariadb locally and tidb-cloud on Vercel.
DATABASE_DRIVER="mariadb"

# OpenAI (server-side only)
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime"
OPENAI_REALTIME_VOICE="marin"
OPENAI_TEXT_MODEL="gpt-5.6-sol"
# Optional server-side HTTP proxy, for example http://127.0.0.1:10808
OPENAI_PROXY_URL=""
REALTIME_MAX_CONCURRENT_SESSIONS="1"
REALTIME_DAILY_MINUTES="60"

# Authentication (Base64 PKCS#8 private key and SPKI public key)
AUTH_PRIVATE_KEY=""
AUTH_PUBLIC_KEY=""
AUTH_KEY_ID="primary"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="zh-CN"
